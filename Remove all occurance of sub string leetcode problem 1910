// solution of leetcode probelm 1910 remove all occurance of sub strings
// s.erase and s.lenght are somethings ne3w which i used in this question for the first time 
// overall question was mid level but felt easy

class Solution {
public:
    string removeOccurrences(string s, string part) {
        while (s.length() > 0 && s.find(part) < s.length()) {
            s.erase(s.find(part), part.size());
        }
        return s;
    }
};
