// solution to leetcode problem 345 
// question was easy only new part for me here was to define isVowel function 

  class Solution {
public:
    bool isVowel(char c) {
        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u' || c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U') {
            return true;
        }
        else {
            return false;
        }
    }
    
    string reverseVowels(string s) {
        int begin = 0, end = s.size() - 1;
        while (begin < end) {
            if (!isVowel(s[begin])) begin++;
            else if (!isVowel(s[end])) end--;
            else { swap(s[begin], s[end]); begin++; end--; }
        }
        return s;
    }
};
