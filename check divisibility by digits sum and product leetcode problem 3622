// solution to leetcode problem 3622
//  question was of easy level and only good part was it gave me a new way to think like returning ans without using if-else function 

class Solution {
public:
    bool checkDivisibility(int n) {
       int original = n;
       int sum = 0;
       int product = 1;
       while( n > 0){
        int digit = n % 10;
        n/=10;
        sum += digit;
        product *= digit ;
    
       }
       return original % (sum + product) == 0;
        
    }
};
