//solution to leetcode problem 523 continuous subarray sum
// question is of mid level , and felt easy if you optimise the brute force approach

class Solution {
public:
    bool checkSubarraySum(vector<int>& nums, int k) {
 unordered_map<int,int> first;
first[0] = -1;
int sum = 0;
for (int i = 0; i < nums.size(); i++) {
    sum += nums[i];
    int rem = sum % k;
    if (first.count(rem)) {
        if (i - first[rem] >= 2) return true;  
    } else {
        first[rem] = i;                          
    }
}
return false;
        
    }
};
