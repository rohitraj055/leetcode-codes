// solution to leetcode problem 2965 find missing and repeated values 
// this question is a easy level problem but it introduced me with many new concepts and algorith like grid frequency etc

class Solution {
public:
    vector<int> findMissingAndRepeatedValues(vector<vector<int>>& grid) {
        int n = grid.size();   

        vector<int> freq(n*n+1, 0);
int repeated=0;
int missing=0;
for(int i=0;i<n;i++){ 
    for(int j=0;j<n;j++){
         freq[grid[i][j]]++;}
         }
for(int num=1; num<=n*n;num++){
    if(freq[num]==2){ 
        repeated = num;}
         if( freq[num]==0){
             missing=num;}}
return { repeated,missing};
    }
};
