// solution of leetcode problem 724 find pivot index

class Solution {
public:
 int pivotIndex(vector<int>& nums) 
 { int leftSum =0; 
 int totalSum = 0; 
 { for ( int i =0;i < nums.size() ; i++)
  totalSum += nums[i];
  } 
  for (int i =0; i <nums.size(); i++) {
     int rightSum = totalSum - leftSum - nums[i]; 
     if( rightSum == leftSum )
     { return i;} 
     else { leftSum += nums[i];} 
     } 
     return -1;
     }
        
};
