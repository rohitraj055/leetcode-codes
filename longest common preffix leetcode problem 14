// solution of leetcode problem 14, the question was about finding longest common preffix according to me this was mid to hard level problem it taught me new way to work;

class Solution {
public:
    string longestCommonPrefix(vector<string>& strs) {
        string prefix = strs[0]; 
        for(int i=0;i<strs.size();i++)
        { string word=strs[i];
         int j=0;
          while( j< prefix.length() && j<word.length()&& prefix[j]==word[j]){
            j++;
            } { 
                prefix=prefix.substr(0,j);
                 if(prefix==""){
                    break;
                    }
                    }}
                    return prefix;
        
        
        
        
    }
};
