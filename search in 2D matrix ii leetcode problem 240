//solution to leetcode problem 240 search in 2D matrix
// the question felt soo easy after solving the question number 74 leetcode that is search in 2D matrix i

class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
int m = matrix.size(), n = matrix[0].size();
        int r=0;
int c =n-1;
while(c>=0 && r<m){
if(target==matrix[r][c]){
return true;
}
else if(target<matrix[r][c]){
c--;}
else {
r++;}
}
return false;
    }
};
