//solution to leetcode problem 59 spiral matrix ii
// the problem felt me quite easy after solving spiral matrix i, the only difference was here there is n*n matrix while there was n*m matrix

class Solution {
public:
    vector<vector<int>> generateMatrix(int n) {
vector<vector<int>> result(n, vector<int>(n, 0));
int num=1;
int top=0,bottom=n-1,left=0,right=n-1;
while(left<=right && top<=bottom){
     {for(int i=left;i<=right;i++){ 
        result[top][i]=num;
num++;}
         top++; }
{
    for(int j=top;j<=bottom;j++){
        result[j][right]=num;num++;}
         right--;}
          if(top<=bottom){
            for(int k=right; k>=left;k--){
                result[bottom][k]=num;num++;}
                 bottom--;}
                 if(left<=right){
                    for(int l=bottom; l>=top;l--){
                        result[l][left]=num;num++;}
                         left++;}}
        
   return result;
   }
};
