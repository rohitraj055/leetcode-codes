// solution to leetcode problem 974 subarray sum divisible  by k 
// the question is of mid level , i have started it with brute force approach later optimized it;
// learned using map function to track

class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
unordered_map<int,int>mp;
mp[0]=1;
int sum=0;
int count=0;
for(int i=0;i<nums.size();i++){
    sum+=nums[i];
    int rem= ((sum%k)+k)%k;
    count+=mp[rem]; mp[rem]++;}

return count;
        }
};
