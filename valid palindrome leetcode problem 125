// solution of leetcode problem 125\

//solution 1 using two pointer approch
//only new part was to use of isalnum 

class Solution {
public:
    bool isPalindrome(string s) {
        int st=0;
         int end = s.size()-1;
          while ( st <= end){
             if (! isalnum( s[st]) ) { st++; continue;}
              if(! isalnum( s[end] )){ end-- ; continue;} 
              if ( tolower( s[ st] )!= tolower( s[end]))
               { return false;}
                else { st ++ ; end--;}
                 }
                  return true;
        
    }
};
